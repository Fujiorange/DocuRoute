datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  description   String?
  isSystemRole  Boolean  @default(false)
  systemRoleKey String?
  permissions   String[] // Permission enum values; ignored for system roles
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id])
  users         User[]
  // GIN index for permission queries — created in migration 20260323_performance_indexes
  // Required by createNotificationsForPermission to avoid full-table scans.

  @@unique([companyId, name])
  @@index([companyId, isSystemRole])
}

model Company {
  id                             String             @id @default(cuid())
  name                           String
  slug                           String             @unique
  planTier                       String             @default("PILOT")
  recycleBinRetentionDays        Int                @default(90)
  bulkOperationUndoWindowMinutes Int                @default(30)
  viewLogRetentionDays           Int                @default(90) // Retention for DocumentView logs
  transmittalTemplate            Json?
  // Feature flags for plan-gated capabilities.
  // Expected shape: { "customRoles": boolean, "advancedWorkflows": boolean, "scim": boolean }
  // Unset key = feature disabled. Never rely on absent key = enabled.
  // Set at onboarding. Modifiable by PLATFORM_ADMIN only.
  features                       Json?
  // Per-company security policy overrides.
  // Expected shape: { "mfaRequired": boolean, "sessionTimeoutMinutes": number }
  // If null, system defaults apply.
  securitySettings               Json?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  roles                          Role[]
  users                          User[]
  projects                       Project[]
  documents                      Document[]
  documentRevisions              DocumentRevision[]
  onboarding                     CompanyOnboarding?
  notifications                  Notification[]
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  companyId         String
  roleId            String
  isActive          Boolean  @default(false)
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?
  scimDeprovisioned Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id])
  role              Role     @relation(fields: [roleId], references: [id])

  @@index([companyId, roleId])
  @@index([companyId, isActive])
}

// Minimal Project model — required for Document.projectId FK
// Phase 2 adds full project management fields
model Project {
  id        String     @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id])
  documents Document[]

  @@index([companyId])
}

model Document {
  id                   String            @id @default(cuid())
  companyId            String
  projectId            String?
  documentCode         String?           // Document register code (e.g., "DWG-001", "SPEC-042")
  title                String?           // Document title for register view
  filename             String
  fileKey              String
  fileSize             Int
  mimeType             String
  sha256Hash           String
  uploadedBy           String            // userId

  // Industry fields — required from day 1, not deferred to Phase 2.
  // Field workers need discipline and issue purpose the moment a document is uploaded.
  discipline           String?           // EngineeringDiscipline enum value
  issuePurpose         String?           // IssuePurpose enum value

  status               String            @default("PENDING") // DocumentStatus enum value
  virusScanStatus      String            @default("PENDING") // VirusScanStatus enum value
  virusScanCompletedAt DateTime?
  watermarkStatus      String            @default("PENDING") // WatermarkStatus enum value
  hasSearchableContent Boolean           @default(false) // Quick flag for full-text search filtering
  metadata             Json?             // For { watermarkSkipped: true, reason, acknowledgedByUserId, acknowledgedAt }
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  company              Company           @relation(fields: [companyId], references: [id])
  project              Project?          @relation(fields: [projectId], references: [id])
  content              DocumentContent?
  // pg_trgm GIN indexes for fuzzy search — created in migration 20260323_performance_indexes
  // Required for fast document search (<500ms with 100,000+ documents)

  @@unique([projectId, documentCode])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, projectId])
  @@index([projectId, status, createdAt])
  @@index([companyId, hasSearchableContent])
}

// Minimal DocumentRevision model — required for QR verification route
// Phase 2 extends this to full DocumentRecord/Revision split
model DocumentRevision {
  id               String   @id @default(cuid())
  documentId       String
  companyId        String
  revisionCode     String
  fileKey          String
  fileSize         Int
  sha256Hash       String
  discipline       String? // EngineeringDiscipline enum value
  issuePurpose     String? // IssuePurpose enum value
  status           String   @default("CURRENT") // CURRENT | SUPERSEDED | DRAFT
  watermarkStatus  String   @default("PENDING") // WatermarkStatus enum value
  watermarkFileKey String?
  uploadedBy       String
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id])

  @@index([documentId, status])
  @@index([companyId])
}

// DocumentContent — Full-text search for PDF documents.
// Stores extracted text from PDFs with PostgreSQL tsvector for fast full-text search.
// GIN index on searchVector enables sub-second search across millions of documents.
model DocumentContent {
  id           String                   @id @default(cuid())
  documentId   String                   @unique
  companyId    String                   // Denormalized for RLS policies
  revisionCode String                   // Which revision this content belongs to
  plainText    String                   @db.Text // Extracted PDF text
  searchVector Unsupported("tsvector")? // PostgreSQL tsvector for full-text search
  extractedAt  DateTime                 @default(now())
  pageCount    Int?                     // Number of pages in PDF
  fileSize     Int?                     // Size in bytes for metrics
  document     Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  company      Company                  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, documentId])
}

model AuditLog {
  id              String   @id @default(cuid())
  companyId       String
  userId          String?
  action          String // AuditAction enum value
  resourceType    String?
  resourceId      String?
  ipAddress       String?
  userAgent       String?
  permissionsUsed String[] // Permission enum values used to authorise this action
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, action])
}

// AuditVaultEntry — IMMUTABLE compliance log.
// INSERT ONLY. The database trigger below enforces this at the DB level.
// Application code must never call update() or delete() on this model.
//
// REQUIRED SQL — run in Supabase SQL Editor after every schema migration:
//
//   CREATE OR REPLACE FUNCTION prevent_audit_vault_mutation()
//   RETURNS TRIGGER AS $$
//   BEGIN
//     RAISE EXCEPTION 'AuditVaultEntry is INSERT ONLY. Tampering detected.';
//   END;
//   $$ LANGUAGE plpgsql;
//
//   CREATE TRIGGER audit_vault_immutable
//   BEFORE UPDATE OR DELETE ON "AuditVaultEntry"
//   FOR EACH ROW EXECUTE FUNCTION prevent_audit_vault_mutation();
//
// Verify trigger is active:
//   SELECT tgname FROM pg_trigger WHERE tgrelid = '"AuditVaultEntry"'::regclass;
model AuditVaultEntry {
  id                  String   @id @default(cuid())
  companyId           String
  eventType           String // AuditVaultEventType enum value
  userId              String?
  userEmail           String // snapshot — never rely on FK for compliance
  ipAddress           String?
  userAgent           String?
  permissionsUsed     String[] // Permission[] that were verified before this event
  metadata            Json?
  documentFingerprint String? // SHA-256 of document file at event time
  hash                String // SHA-256 integrity hash of this record
  createdAt           DateTime // Set explicitly by application — NOT @default(now())
  // Must match value used to compute hash field above

  @@index([companyId, createdAt])
  @@index([companyId, eventType])
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  companyId  String
  roleId     String // FK to Role table — not a role name string
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([email, companyId])
}

model TransmittalCounter {
  companyId String
  year      Int
  sequence  Int    @default(0)

  @@id([companyId, year])
}

model Transmittal {
  id          String   @id @default(cuid())
  companyId   String
  number      String // Generated format: "TR-2026-001"
  subject     String
  message     String?
  status      String   @default("DRAFT") // DRAFT | SENT | ACKNOWLEDGED | RETURNED
  sentAt      DateTime?
  expiresAt   DateTime? // Optional expiration for public access
  createdBy   String // userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   TransmittalDocument[]
  recipients  TransmittalRecipient[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model TransmittalDocument {
  id            String   @id @default(cuid())
  transmittalId String
  documentId    String
  revisionId    String // LOCKED — never changes even if new revision uploaded
  addedAt       DateTime @default(now())
  transmittal   Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)

  @@unique([transmittalId, documentId])
  @@index([transmittalId])
  @@index([documentId])
}

model TransmittalRecipient {
  id             String    @id @default(cuid())
  transmittalId  String
  email          String
  name           String?
  company        String?
  token          String    @unique // For public access
  status         String    @default("PENDING") // PENDING | VIEWED | ACKNOWLEDGED
  viewedAt       DateTime?
  acknowledgedAt DateTime?
  message        String? // Acknowledgment message or return reason
  createdAt      DateTime  @default(now())
  transmittal    Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)

  @@index([transmittalId])
  @@index([token])
  @@index([email])
}

model CompanyTransmittalConfig {
  id            String   @id @default(cuid())
  companyId     String   @unique
  numberPrefix  String   @default("TR") // e.g., "TR", "SHP", "BLD"
  numberPadding Int      @default(3) // Number of digits: 001, 0001, etc.
  columns       Json     @default("{\"documentCode\": {\"enabled\": true, \"label\": \"Document Code\", \"order\": 0}, \"title\": {\"enabled\": true, \"label\": \"Title\", \"order\": 1}, \"revisionCode\": {\"enabled\": true, \"label\": \"Revision\", \"order\": 2}, \"status\": {\"enabled\": false, \"label\": \"Status\", \"order\": 3}, \"discipline\": {\"enabled\": false, \"label\": \"Discipline\", \"order\": 4}}") // Column configuration
  headerFields  Json     @default("{\"projectName\": {\"enabled\": false, \"label\": \"Project Name\"}, \"attentionTo\": {\"enabled\": false, \"label\": \"Attention To\"}, \"subject\": {\"enabled\": true, \"label\": \"Subject\"}}") // Header field configuration
  footerText    String?  // Custom footer text for transmittals
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

model CompanyOnboarding {
  id             String   @id @default(cuid())
  companyId      String   @unique
  completedSteps String[] @default([])
  // Valid step values:
  //   'FIRST_PROJECT_CREATED' | 'FIRST_DOCUMENT_UPLOADED' |
  //   'FIRST_TEAM_MEMBER_INVITED' | 'NAMING_MASK_CONFIGURED' |
  //   'FIRST_WORKFLOW_STARTED'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  type      String // NotificationType enum value
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  // Composite index for unread notifications — created in migration 20260323_performance_indexes
  // Optimizes common query: "Get unread notifications ordered by date"

  @@index([userId, isRead])
  @@index([companyId, createdAt])
  @@index([userId, isRead, createdAt])
}

// DocumentView — View access logging for ITAR/export-control compliance
// Records every time a user views, previews, downloads, or QR-scans a document
// Required for regulated industries (maritime, defense, aerospace)
model DocumentView {
  id         String   @id @default(cuid())
  documentId String
  userId     String?  // Nullable for public QR scans
  companyId  String   // Denormalized for RLS
  viewType   ViewType
  ipAddress  String?  // From x-forwarded-for header
  userAgent  String?  // From user-agent header
  viewedAt   DateTime @default(now())
  sessionId  String?  // For grouping views in one session

  @@index([documentId])
  @@index([userId])
  @@index([companyId])
  @@index([viewedAt])
  @@index([sessionId])
  @@index([companyId, documentId, viewedAt]) // Optimized for view history queries
}

enum ViewType {
  DETAIL_PAGE // User opened document details page
  PREVIEW     // User previewed PDF in browser
  DOWNLOAD    // User downloaded file
  QR_SCAN     // Public QR code verification scan
}
