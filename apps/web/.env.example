# Database (Supabase)
DATABASE_URL=               # ← PgBouncer pooled URL (port 6543)
DIRECT_URL=                 # ← Direct connection (port 5432) for migrations

# Enterprise per-tenant DB isolation (optional, Pillar 3 — dynamic multi-tenancy)
# Set TENANT_DB_URL_[COMPANY_ID] to point an enterprise client to a dedicated instance.
# Example: TENANT_DB_URL_clxyz123=postgresql://dedicated-host/db
# Unset = shared DB with companyId filter (correct for all pilot + standard clients)
# This is the ONLY change needed to give a client physical DB isolation.

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AWS KMS
AWS_KMS_KEY_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
LOCAL_KMS_MODE=false        # ← true for local dev ONLY, throws in production

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# BullMQ / Redis (shared with worker)
REDIS_URL=

# Cron Protection
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_VERSION=0.1.0

# Platform Admin
PLATFORM_ADMIN_EMAIL=

# Pilot Seeding
PILOT_OWNER_EMAIL=
PILOT_PROJECT_NAME=
PILOT_NAMING_MASK=

# Virus Scanning (required — skipping is a documented pilot limitation only)
VIRUSTOTAL_API_KEY=

# QR Status Verification — must be publicly accessible (no login required)
QR_VERIFICATION_BASE_URL=   # ← e.g. https://docuroute.io

# Full-Text PDF Search
SEARCH_FULLTEXT_ENABLED=true        # ← Enable full-text PDF search feature
SEARCH_MAX_RESULTS=100              # ← Maximum search results per query
PDF_EXTRACTION_TIMEOUT_SECONDS=30   # ← PDF text extraction timeout
